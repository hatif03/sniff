# =============================================================================
# Sniff — Root .gitignore
# =============================================================================
# Covers the entire monorepo (sniff-ai/ + sniff-web/).
# Sub-project .gitignore files handle project-specific patterns.
# This root file protects against repo-root credential exposure and enforces
# security hygiene regardless of the working directory used.
#
# Decision: Root-level .gitignore is preferred because running `sniff init`
# from the repo root would otherwise create sniff.json with API keys at
# a location not covered by sub-project ignores.
# =============================================================================

# =============================================================================
# SECRETS & CREDENTIALS — NEVER COMMIT THESE
# =============================================================================
.env
.env.*
!.env.example
!.env.local.example
*.env

# Sniff runtime config (generated by `sniff init` — contains API keys)
sniff.json

# AWS credential files
.aws/credentials
.aws/config
aws-credentials.json
aws_credentials.json

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_ed25519
*.ppk

# Supabase service role key (if accidentally saved locally)
supabase-key.txt
supabase_key.txt

# Typesafe AI / Jev API keys
typesafe-key.txt
jev-key.txt

# Slack webhook URLs saved to file
slack-webhook.txt

# Generic secret files
secrets.json
secrets.yaml
secrets.yml
*.secret
*.secrets

# =============================================================================
# RUNTIME ARTIFACTS (generated by sniff runs — can be large)
# =============================================================================
artifacts/
experiments/
data/
runs/
*.db
*.db-journal
*.db-shm
*.db-wal

# =============================================================================
# PYTHON (sniff-ai)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
ENV/
env/
.env/

# UV package manager cache
.uv/

# pytest / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# mypy / ruff / black caches
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# =============================================================================
# NODE / NEXT.JS (sniff-web)
# =============================================================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
/out/
/build
.vercel
*.tsbuildinfo
next-env.d.ts
coverage/

# =============================================================================
# PLAYWRIGHT
# =============================================================================
playwright-report/
test-results/
trace.zip
*.trace

# =============================================================================
# LOGS
# =============================================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*

# =============================================================================
# OS & EDITOR
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V4
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# =============================================================================
# TEMPORARY FILES
# =============================================================================
*.tmp
*.temp
.cache/
tmp/
temp/
