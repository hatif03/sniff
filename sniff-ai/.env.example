# .env.example - Template for Sherlock environment variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================================
# AWS Credentials
# ============================================================================
# Option 1: Use AWS CLI profile (recommended for development)
# AWS_PROFILE=sherlock

# Option 2: Use explicit credentials (for CI/CD or when profile not available)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=  # Optional, for temporary credentials

# ============================================================================
# AWS Region Configuration
# ============================================================================
AWS_DEFAULT_REGION=us-west-2
AWS_REGION=us-west-2

# ============================================================================
# Bedrock Model Configuration
# ============================================================================
# Primary model for agent decisions
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Fallback model if primary unavailable
BEDROCK_MODEL_FALLBACK=anthropic.claude-3-5-sonnet-20241022-v2:0

# Region for Bedrock service
BEDROCK_REGION=us-west-2

# Optional: Cross-region inference profile ARN
# BEDROCK_INFERENCE_PROFILE_ARN=arn:aws:bedrock:us-west-2:ACCOUNT:inference-profile/sherlock

# ============================================================================
# Bedrock Invocation Parameters
# ============================================================================
# Maximum tokens in model response
BEDROCK_MAX_TOKENS=4096

# Temperature (0.0 = deterministic, 1.0 = creative)
BEDROCK_TEMPERATURE=0.7

# Request timeout in seconds
BEDROCK_TIMEOUT_SECONDS=60

# Maximum retry attempts on transient failures
BEDROCK_MAX_RETRIES=3

# Anthropic API version
BEDROCK_ANTHROPIC_VERSION=bedrock-2023-05-31

# Top-p sampling (optional, 0.0-1.0)
BEDROCK_TOP_P=0.9

# Top-k sampling (optional)
BEDROCK_TOP_K=250

# ============================================================================
# Sherlock Application Configuration
# ============================================================================
# Environment: development | staging | production
SHERLOCK_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
SHERLOCK_LOG_LEVEL=INFO

# Database path (SQLite)
SHERLOCK_DB_PATH=./data/sherlock.db

# Artifacts storage path
SHERLOCK_ARTIFACTS_PATH=./artifacts

# ============================================================================
# Slack Integration (Optional)
# ============================================================================
# Webhook URL for Slack alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel for alerts (optional, override webhook default)
# SLACK_CHANNEL=#sherlock-alerts

# Slack username for bot (optional)
# SLACK_BOT_NAME=Sherlock Alert Bot

# ============================================================================
# Supabase Integration (Optional)
# ============================================================================
# Enable Supabase upload after each run
SUPABASE_ENABLED=true

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/service key
SUPABASE_KEY=your-supabase-anon-key

# Auto-upload runs to Supabase after completion
SUPABASE_AUTO_UPLOAD=true

# Storage bucket names (should match schema setup)
SUPABASE_SCREENSHOTS_BUCKET=sherlock-screenshots
SUPABASE_VIDEOS_BUCKET=sherlock-videos
SUPABASE_TRACES_BUCKET=sherlock-traces

# ============================================================================
# Playwright Configuration
# ============================================================================
# Browser headless mode (true for production, false for debugging)
PLAYWRIGHT_HEADLESS=true

# Screenshot on every action (useful for debugging)
PLAYWRIGHT_SCREENSHOT_ON_ACTION=true

# Slow motion in milliseconds (for debugging, 0 = off)
PLAYWRIGHT_SLOW_MO=0

# Default timeout for page actions (milliseconds)
PLAYWRIGHT_TIMEOUT=30000

# Navigation timeout (milliseconds)
PLAYWRIGHT_NAVIGATION_TIMEOUT=60000

# ============================================================================
# Security and Compliance
# ============================================================================
# Domain allowlist (comma-separated, no spaces)
SHERLOCK_ALLOWED_DOMAINS=staging.example.com,test.example.com

# Maximum run duration in seconds (safety limit)
SHERLOCK_MAX_RUN_DURATION=300

# PII redaction in logs
SHERLOCK_REDACT_PII=true

# Disable risky actions outside allowed domains
SHERLOCK_ENFORCE_DOMAIN_ALLOWLIST=true

# ============================================================================
# Performance and Limits
# ============================================================================
# Maximum steps per run (prevent infinite loops)
SHERLOCK_MAX_STEPS=50

# Maximum retries per intent
SHERLOCK_MAX_INTENT_RETRIES=3

# Maximum dwell time per screen (seconds)
SHERLOCK_MAX_DWELL_TIME=30

# Hard timeout per run (seconds)
SHERLOCK_HARD_TIMEOUT=600

# ============================================================================
# Advanced Bedrock Settings (Optional)
# ============================================================================
# Connection pool settings
# BEDROCK_MAX_POOL_CONNECTIONS=10
# BEDROCK_CONNECTION_TIMEOUT=10
# BEDROCK_READ_TIMEOUT=60

# Cost control
# BEDROCK_DAILY_REQUEST_LIMIT=1000
# BEDROCK_COST_ALERT_THRESHOLD=100.00

# Debugging
# BEDROCK_DEBUG_MODE=false
# BEDROCK_LOG_REQUESTS=false
# BEDROCK_LOG_RESPONSES=false

# ============================================================================
# Persona Configuration
# ============================================================================
# Default persona for runs (if not specified)
# SHERLOCK_DEFAULT_PERSONA=confused_first_time_user

# Persona storage path
# SHERLOCK_PERSONAS_PATH=./src/personas

# ============================================================================
# Device Emulation Defaults
# ============================================================================
# Default device profile (see Playwright device descriptors)
# SHERLOCK_DEFAULT_DEVICE=iPhone 13

# Default network profile (4g | 3g | slow3g | offline)
# SHERLOCK_DEFAULT_NETWORK=4g

# ============================================================================
# Database Configuration
# ============================================================================
# SQLite database path
# SHERLOCK_DB_PATH=./data/sherlock.db

# Enable WAL mode for better concurrency
# SHERLOCK_DB_WAL_MODE=true

# Database backup on run completion
# SHERLOCK_DB_BACKUP=false

# ============================================================================
# Artifact Storage
# ============================================================================
# Base path for run artifacts
# SHERLOCK_ARTIFACTS_PATH=./artifacts

# Artifact retention days (0 = keep forever)
# SHERLOCK_ARTIFACT_RETENTION_DAYS=30

# Compress artifacts (saves space)
# SHERLOCK_ARTIFACT_COMPRESSION=true

# ============================================================================
# Diagnosis Engine
# ============================================================================
# Use LLM for diagnosis (true) or rule-based only (false)
# SHERLOCK_DIAGNOSIS_USE_LLM=true

# Diagnosis model (can differ from agent model for cost savings)
# SHERLOCK_DIAGNOSIS_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ============================================================================
# Development/Testing
# ============================================================================
# Enable demo mode (deterministic test paths)
# SHERLOCK_DEMO_MODE=false

# Skip actual browser launch (for unit tests)
# SHERLOCK_TEST_MODE=false

# Mock Bedrock responses (for testing without API calls)
# SHERLOCK_MOCK_BEDROCK=false

# ============================================================================
# Observability (Optional)
# ============================================================================
# OpenTelemetry endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Trace sampling rate (0.0-1.0)
# OTEL_TRACE_SAMPLING_RATE=1.0

# Service name for tracing
# OTEL_SERVICE_NAME=sherlock

# ============================================================================
# Feature Flags (Optional)
# ============================================================================
# Enable experimental features
# SHERLOCK_EXPERIMENTAL_FEATURES=false

# Enable Strands Agents framework
# SHERLOCK_USE_STRANDS=false

# Enable multi-agent orchestration
# SHERLOCK_MULTI_AGENT=false

# ============================================================================
# Supabase Integration (Optional)
# ============================================================================
# Enable Supabase upload for artifacts and run data
# SUPABASE_ENABLED=true

# Supabase project URL (from Project Settings → API)
# SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (from Project Settings → API)
# SUPABASE_KEY=your-anon-key-here

# Auto-upload artifacts after each run
# SUPABASE_AUTO_UPLOAD=true

# Storage bucket names (created automatically by schema)
# SUPABASE_SCREENSHOTS_BUCKET=sherlock-screenshots
# SUPABASE_VIDEOS_BUCKET=sherlock-videos
# SUPABASE_TRACES_BUCKET=sherlock-traces
