# .env.example - Template for Sniff environment variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================================
# Gemini (Vertex AI) Configuration - Tier 3 vision-capable reasoning
# ============================================================================
# Auth is via Application Default Credentials, NOT an API key:
#   gcloud auth application-default login
#   gcloud config set project <your-project-id>
# Vertex AI API must be enabled: gcloud services enable aiplatform.googleapis.com
GEMINI_PROJECT_ID=your-gcp-project-id

# Vertex AI region. Gemini 3.x's newest tiers aren't uniformly available in
# every regional location yet - us-central1 is the safe default.
GEMINI_REGION=us-central1

# Primary model (fast/cheap, for the frequent per-step vision call)
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# Fallback if the primary isn't available in your region/project
GEMINI_FALLBACK_MODEL_ID=gemini-2.5-flash-lite

# Maximum tokens in model response
GEMINI_MAX_TOKENS=4096

# Temperature (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=0.7

# Request timeout in seconds
GEMINI_TIMEOUT_SECONDS=60

# ============================================================================
# k2-horizon (ifm.ai) Configuration - Tier 3 text-only reasoning
# ============================================================================
# Used for goal enhancement, next-action planning, and persona reviews -
# none of these need vision, so they're routed here instead of Gemini.
IFM_API_KEY=your-ifm-api-key

# API base URL (OpenAI-compatible - the ifm.ai docs recommend the `openai`
# package pointed at this base_url rather than a bespoke client)
IFM_BASE_URL=https://api.ifm.ai/v1

# Model ID
IFM_MODEL_ID=IFM/K2-Horizon-375B-A23B

# Temperature (0.0 = deterministic, 1.0 = creative)
IFM_TEMPERATURE=0.7

# Request timeout in seconds
IFM_TIMEOUT_SECONDS=60

# ============================================================================
# Sniff Application Configuration
# ============================================================================
# Environment: development | staging | production
SNIFF_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
SNIFF_LOG_LEVEL=INFO

# Database path (SQLite)
SNIFF_DB_PATH=./data/sniff.db

# Artifacts storage path
SNIFF_ARTIFACTS_PATH=./artifacts

# ============================================================================
# Typesafe AI / Jev Configuration (Tier 2 fast decision model)
# ============================================================================
# Disabled by default. When false (or unset), the three Jev-backed roles
# (goal-reached check, Tier-3 context enrichment, decision critique) are all
# no-ops and behavior is identical to Bedrock-only decision making.
# TYPESAFE_ENABLED=false

# API key for Typesafe AI (get from https://console.typesafe.ai/keys)
# TYPESAFE_API_KEY=your-typesafe-api-key

# Typesafe API base URL — verify against the real API reference once you
# have a key; the public docs don't publish exact endpoint paths as of writing.
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# Jev model ID
# TYPESAFE_MODEL_ID=jev-latest

# Request timeout in seconds (Jev is designed to respond in under 1s)
# TYPESAFE_TIMEOUT_SECONDS=5

# ============================================================================
# API Backend (src/api/main.py) - Phase 1 shared-secret gate
# ============================================================================
# Shared bearer token required on POST/GET /runs and /experiments
# (Authorization: Bearer <token>). Not per-user auth - that's Phase 2,
# see docs/product/SAAS_ROADMAP.md section 1. Required for the API to accept
# authenticated requests; /status never needs it.
SNIFF_API_TOKEN=change-me-to-a-long-random-secret

# Origin allowed to call the API via CORS (the Next.js frontend)
SNIFF_API_CORS_ORIGIN=http://localhost:3000

# ============================================================================
# Slack Integration (Optional)
# ============================================================================
# Webhook URL for Slack alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel for alerts (optional, override webhook default)
# SLACK_CHANNEL=#sniff-alerts

# Slack username for bot (optional)
# SLACK_BOT_NAME=Sniff Alert Bot

# ============================================================================
# Supabase Integration (Optional)
# ============================================================================
# Enable Supabase upload after each run
SUPABASE_ENABLED=true

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/service key
SUPABASE_KEY=your-supabase-anon-key

# Auto-upload runs to Supabase after completion
SUPABASE_AUTO_UPLOAD=true

# Storage bucket names (should match schema setup)
SUPABASE_SCREENSHOTS_BUCKET=sniff-screenshots
SUPABASE_VIDEOS_BUCKET=sniff-videos
SUPABASE_TRACES_BUCKET=sniff-traces

# ============================================================================
# Playwright Configuration
# ============================================================================
# Browser headless mode (true for production, false for debugging)
PLAYWRIGHT_HEADLESS=true

# Screenshot on every action (useful for debugging)
PLAYWRIGHT_SCREENSHOT_ON_ACTION=true

# Slow motion in milliseconds (for debugging, 0 = off)
PLAYWRIGHT_SLOW_MO=0

# Default timeout for page actions (milliseconds)
PLAYWRIGHT_TIMEOUT=30000

# Navigation timeout (milliseconds)
PLAYWRIGHT_NAVIGATION_TIMEOUT=60000

# ============================================================================
# Security and Compliance
# ============================================================================
# Domain allowlist (comma-separated, no spaces)
SNIFF_ALLOWED_DOMAINS=staging.example.com,test.example.com

# Maximum run duration in seconds (safety limit)
SNIFF_MAX_RUN_DURATION=300

# PII redaction in logs
SNIFF_REDACT_PII=true

# Disable risky actions outside allowed domains
SNIFF_ENFORCE_DOMAIN_ALLOWLIST=true

# ============================================================================
# Performance and Limits
# ============================================================================
# Maximum steps per run (prevent infinite loops)
SNIFF_MAX_STEPS=50

# Maximum retries per intent
SNIFF_MAX_INTENT_RETRIES=3

# Maximum dwell time per screen (seconds)
SNIFF_MAX_DWELL_TIME=30

# Hard timeout per run (seconds)
SNIFF_HARD_TIMEOUT=600

# Max pages crawled/audited per whole-site audit (hard ceiling 30)
SNIFF_MAX_SITE_AUDIT_PAGES=10

# Max link-following depth from the seed page during site-audit discovery
SNIFF_MAX_SITE_AUDIT_DEPTH=3

# Hard timeout for a whole-site audit (seconds) - larger than SNIFF_HARD_TIMEOUT
# since a multi-page crawl legitimately takes longer than one page
SNIFF_SITE_AUDIT_HARD_TIMEOUT=1800

# ============================================================================
# Persona Configuration
# ============================================================================
# Default persona for runs (if not specified)
# SNIFF_DEFAULT_PERSONA=confused_first_time_user

# Persona storage path
# SNIFF_PERSONAS_PATH=./src/personas

# ============================================================================
# Device Emulation Defaults
# ============================================================================
# Default device profile (see Playwright device descriptors)
# SNIFF_DEFAULT_DEVICE=iPhone 13

# Default network profile (4g | 3g | slow3g | offline)
# SNIFF_DEFAULT_NETWORK=4g

# ============================================================================
# Database Configuration
# ============================================================================
# SQLite database path
# SNIFF_DB_PATH=./data/sniff.db

# Enable WAL mode for better concurrency
# SNIFF_DB_WAL_MODE=true

# Database backup on run completion
# SNIFF_DB_BACKUP=false

# ============================================================================
# Artifact Storage
# ============================================================================
# Base path for run artifacts
# SNIFF_ARTIFACTS_PATH=./artifacts

# Artifact retention days (0 = keep forever)
# SNIFF_ARTIFACT_RETENTION_DAYS=30

# Compress artifacts (saves space)
# SNIFF_ARTIFACT_COMPRESSION=true

# ============================================================================
# Diagnosis Engine
# ============================================================================
# Use LLM for diagnosis (true) or rule-based only (false)
# SNIFF_DIAGNOSIS_USE_LLM=true

# Diagnosis model (can differ from agent model for cost savings)
# SNIFF_DIAGNOSIS_MODEL_ID=gemini-2.5-flash-lite

# ============================================================================
# Development/Testing
# ============================================================================
# Enable demo mode (deterministic test paths)
# SNIFF_DEMO_MODE=false

# Skip actual browser launch (for unit tests)
# SNIFF_TEST_MODE=false

# Mock LLM responses (for testing without API calls)
# SNIFF_MOCK_LLM=false

# ============================================================================
# Observability (Optional)
# ============================================================================
# OpenTelemetry endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Trace sampling rate (0.0-1.0)
# OTEL_TRACE_SAMPLING_RATE=1.0

# Service name for tracing
# OTEL_SERVICE_NAME=sniff

# ============================================================================
# Feature Flags (Optional)
# ============================================================================
# Enable experimental features
# SNIFF_EXPERIMENTAL_FEATURES=false

# Enable multi-agent orchestration
# SNIFF_MULTI_AGENT=false

# ============================================================================
# Supabase Integration (Optional)
# ============================================================================
# Enable Supabase upload for artifacts and run data
# SUPABASE_ENABLED=true

# Supabase project URL (from Project Settings → API)
# SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (from Project Settings → API)
# SUPABASE_KEY=your-anon-key-here

# Auto-upload artifacts after each run
# SUPABASE_AUTO_UPLOAD=true

# Storage bucket names (created automatically by schema)
# SUPABASE_SCREENSHOTS_BUCKET=sniff-screenshots
# SUPABASE_VIDEOS_BUCKET=sniff-videos
# SUPABASE_TRACES_BUCKET=sniff-traces
